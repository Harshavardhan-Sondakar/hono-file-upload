{
  "name": "hono-file-upload",
  "version": "0.1.0",
  "description": "Streaming file upload middleware for Hono. Size limits, type checks, and memory, disk or S3 storage. Works on Node, Bun, Deno and Cloudflare Workers.",
  "keywords": [
    "hono",
    "middleware",
    "upload",
    "file-upload",
    "multipart",
    "form-data",
    "multer",
    "s3",
    "r2",
    "streaming"
  ],
  "license": "MIT",
  "author": "Harshavardhan Sondakar <hmsondakar@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harshavardhan-Sondakar/hono-file-upload.git"
  },
  "homepage": "https://github.com/Harshavardhan-Sondakar/hono-file-upload#readme",
  "bugs": "https://github.com/Harshavardhan-Sondakar/hono-file-upload/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./disk": {
      "import": {
        "types": "./dist/disk.d.ts",
        "default": "./dist/disk.js"
      },
      "require": {
        "types": "./dist/disk.d.cts",
        "default": "./dist/disk.cjs"
      }
    },
    "./s3": {
      "import": {
        "types": "./dist/s3.d.ts",
        "default": "./dist/s3.js"
      },
      "require": {
        "types": "./dist/s3.d.cts",
        "default": "./dist/s3.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "multitars": "^1.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@biomejs/biome": "^2.5.15",
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.4",
    "aws-sdk-client-mock": "^4.1.0",
    "hono": "^4.13.13",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
